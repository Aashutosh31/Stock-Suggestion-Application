# ─────────────────────────────────────────────────────────────
# Nivesh Terminal — Backend environment template
# Copy to `.env` and fill in values. NEVER commit a real `.env`.
#   cp server/.env.example server/.env
# ─────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_NAME=Nivesh Terminal
API_PREFIX=/api/v1
LOG_LEVEL=info
TRUST_PROXY=false

# ── Database (REQUIRED) ──────────────────────────────────────
# Local Docker:  mongodb://127.0.0.1:27017/nivesh_terminal
# Atlas:         mongodb+srv://<user>:<pass>@<cluster>/nivesh_terminal?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/nivesh_terminal

# ── Authentication (REQUIRED) ────────────────────────────────
# Generate strong values, e.g.:  openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-string-access
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12
# Cookies: leave COOKIE_DOMAIN empty for localhost. Set COOKIE_SECURE=true in production (HTTPS).
# COOKIE_SAMESITE: omit for the safe default (strict in prod, lax in dev).
#   Use "none" ONLY for cross-site deploys (e.g. Vercel frontend + Render backend on
#   different domains); it requires COOKIE_SECURE=true.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=

# ── CORS (REQUIRED) ──────────────────────────────────────────
# Comma-separated allowlist of frontend origins.
CLIENT_ORIGIN=http://localhost:5173

# ── Market data (REQUIRED) ───────────────────────────────────
# demo  = deterministic, clearly-labelled simulated data (works with zero credentials)
# yahoo = live/delayed quotes via Yahoo Finance public endpoints (unofficial, best-effort)
MARKET_DATA_PROVIDER=demo
MARKET_DATA_TIMEOUT_MS=8000
MARKET_DATA_RETRIES=2
QUOTE_CACHE_TTL_SECONDS=30
HISTORY_CACHE_TTL_SECONDS=300
SEARCH_CACHE_TTL_SECONDS=3600
FUNDAMENTALS_CACHE_TTL_SECONDS=3600

# ── Email delivery (OPTIONAL) ────────────────────────────────
# When disabled, password-reset / verification links are logged locally only
# (dev convenience) and alert email notifications are marked "channel disabled".
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Nivesh Terminal <no-reply@nivesh.local>"

# ── AI explanation layer (OPTIONAL, disabled by default) ─────
# Uses Groq's OpenAI-compatible API with the open-weights openai/gpt-oss-120b model.
# When enabled + key present, the suggestion engine may request a natural-language
# summary of ALREADY-COMPUTED, verified metrics. It never fabricates values.
# Get a key at https://console.groq.com/keys
AI_EXPLAIN_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# ── Admin / operations (OPTIONAL) ────────────────────────────
# When set, unlocks extended diagnostics at /api/v1/admin/* via header `x-admin-token`.
ADMIN_DIAGNOSTICS_TOKEN=
